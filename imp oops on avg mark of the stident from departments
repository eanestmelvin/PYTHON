class IT:
    dep="IT"
    def direct(self,a,b,c,d):
        self.a=a
        self.b=b
        self.c=c
        self.d=d
    def display(self):
        print("from {} {} scored {} avg of 300".format(IT.dep,self.d,(self.a+self.b+self.c)//3))
