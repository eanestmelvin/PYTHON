a=[[32,43,54,65,76],
   [79,87,65,34,21],
   [32,76,56,78,76],
   [54,65,76,87,64],
   [59,59,87,87,58]]
top=0
bottom=len(a)-1
left=0
right=len(a[0])-1
while(left<=right and top<=bottom):
    for i in range(left,right+1):
        print(a[top][i],end=" ")
    top=top+1
    for i in range(top,bottom+1):
        print(a[i][right],end=" ")
    right=right-1
    if left<right:
        for i in range(right,left-1,-1):
            print(a[bottom][i],end=" ")
        bottom=bottom-1
    if top<bottom:
        for i in range (bottom,top-1,-1):
            print([i][left],end=" ")
        left=left+1
