#validpassword
s=input("Enter a strong password:")
if (len(s))>9:
    up=lo=dg=sp=0
    for i in s:
        if i.isupper():
            up=up+1
        elif i.islower():
            lo=lo+1
        elif i.isdigit():
            dg=dg+1
        else:
            sp=sp+1
    if up!=0 and lo!=0 and dg!=0 and sp!=0:
        print("it is a srtong password")
    else:
        print("weak")
else:
    print ("tooo short (t_t)")
